     <% layout("/layouts/boilerplate") %>
     <div class="row">
        <div class="col-8 offset-2">

       
    <h3>Edit your Listing</h3> <br>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST"enctype="multipart/form-data">

        <div class="md-3">
            <label for="title" >Title</label>
         <input type="text" name="listing[title]" value="<%= listing.title %>"  class="form-control" required >

             <div  class="valid-feedback">Please enter valid title</div>
        </div>

        <div>
            <label for="description mb-3" >description</label>
            <textarea  type="text" class="form-control" name="listing[description]"required> <%= listing.description %> </textarea>

             <div  class="valid-feedback">Please enter valid description</div>
        </div>
        <div class="mb-3">
         <label for="image" class="form-label">Original Listing Image</label>
         <br>
         <img 
         src="<%=originalImageUrl %>" 
         alt="Listing Image" 
         class="img-fluid rounded" 
         style="max-width: 300px; height: auto; border: 2px solid #ddd; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"
         >
         </div>
        <div>
            <label for="image">Upload New Image</label>
            <input type="file" name="image" value="<%= listing.image.url %>"  class="form-control"  >
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price">price</label>
            <input type="number" name="listing[price]" value="<%= listing.price %>"  class="form-control"required>

             <div  class="invalid-feedback">Please enter valid price</div>
        </div>
        
        <div class="mb-3 col-md-8">
            <label for="country" >country</label>
            <input type="text" name="listing[country]" value="<%= listing.country %>" class="form-control" required>

             <div  class="invalid-feedback">Please enter valid country</div>
        </div>
        </div>

        
        
        <div class="md-3">
            <label for="location">location</label>
            <input type="text" class="form-control" name="listing[location]" value="<%= listing.location %>  " required>
            <div  class="invalid-feedback">Please enter valid location</div>
        </div>

        <button class="btn btn-dark edit-btn mt-3" type="submit">Edit</button>
    </form>
     </div>

     </div>
    
     

