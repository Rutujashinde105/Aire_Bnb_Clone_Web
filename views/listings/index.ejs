
<% layout("/layouts/boilerplate") %>

<style>
   .main_div{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  #filters{
     text-align: center; 
     margin-top: 2rem;
     margin-right: 2rem;
    opacity: 0.7;
  }

   /* .filter{
    text-align: center; 
     margin-top: 2rem;
     margin-right: 2rem;
    opacity: 0.7;
  }   */
  #filters :hover{
      cursor: pointer;
      color: black;
    }

    .tax-info{
      display: none;
    }
    .tax-toggle{
      border: 1px solid black;
      border-radius: 1rem;
      height: 3.5rem;
      padding: 1rem;
      margin-left: 3;
      align-items: center;
    }
</style>
<body>
    <!-- <h3>All wanderlust</h3> -->
     <div class="main_div">
    <div id="filters" >
      <div class="filter" ><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div id="filters">
      <div  class="filter"><i class="fa-solid fa-bed"></i></i></div>
      <p>Room</p>
    </div>
     <div id="filters" >
      <div class="filter" ><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </div>
    <div id="filters">
      <div  class="filter"><i class="fa-solid fa-mountain"></i></i></div>
      <p>Mountains</p>
    </div>
    <div id="filters">
      <div  class="filter"><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing pools</p>
    </div>
    <div id="filters" >
      <div class="filter" ><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>
    <div id="filters">
      <div  class="filter"><i class="fa-solid fa-cow"></i></div>
      <p>Farmes</p>
    </div>
    <div id="filters">
      <div  class="filter"><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
    <div id="filters">
      <div  class="filter"><i class="fa-solid fa-igloo"></i></div>
      <p>Domes</p>
    </div>
    <div id="filters">
      <div  class="filter"><i class="fa-solid fa-ship"></i></div>
      <p>Boats</p>
    </div>

    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
      </div>
    </div>
    </div>


    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(let listing of allListings) {%>
            
    <div class="card col listing-card">
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
    <div class="card-img-overlay " >
      abcd
    </div>
  </a>
  <div class="card-body">
    <p class="card-text text-muted"> &#8377;
  <%= listing.price ? listing.price.toLocaleString("en-IN") : "Price not available" %> /night &nbsp;
   <i class="tax-info">+ 18% GST</i>
</p>



  </div>
</div>



<% } %>

    </div>
    
    <!-- <ul>
    <% for(let listing of allListings) {%>
        <li> <a href="/listings/<%= listing._id %>"><%= listing.title %></a></li>
    <% } %>    
</ul> -->
</body>

<script>
  let taxSwitch=document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", ()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo) {
      if(info.style.display != "inline"){
        info.style.display = "inline";
      } else{
        info.style.display = "none";
      }
    }
  })
</script>


